# ============================================================
# Enterprise Authentication & Security — Server configuration
# Copy this file to server/.env and adjust values as needed.
# NEVER commit the real .env file.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000
# Public origin of the frontend (used for CORS and links inside emails)
CLIENT_ORIGIN=http://localhost:5173
# Base URL used inside verification / reset emails
APP_URL=http://localhost:5173

# --- Database ---
# Path to the SQLite database file (created automatically)
DB_FILE=./data/app.db

# --- Cryptography ---
# Long random secret used to encrypt 2FA secrets at rest (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=change-me-to-a-long-random-secret-value

# --- Session policy ---
# Idle time after which a session expires (minutes)
SESSION_INACTIVITY_MINUTES=30
# Absolute maximum lifetime of a session (hours)
SESSION_MAX_LIFETIME_HOURS=12
# Enforce a single active session per user (true/false)
SINGLE_SESSION=true

# --- Account lockout policy ---
LOCK_MAX_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# --- Password policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
# Number of previous passwords that cannot be reused
PASSWORD_HISTORY_COUNT=5
# Force a password change when the password is older than this (days). Set 0 to disable.
PASSWORD_MAX_AGE_DAYS=90

# --- Tokens ---
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Rate limiting (requests per window) ---
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_RESEND=3
RATE_LIMIT_FORGOT=5

# --- Seeded administrator account (created on first boot if not existing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Administrator
# Must satisfy the password policy (and must not contain your name/email). Change immediately after first login.
ADMIN_PASSWORD=Secure0wner!2026

# --- SMTP (optional). Leave SMTP_HOST empty to print emails to the server console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SecureApp <no-reply@example.com>"

# --- Two-factor authentication ---
TOTP_ISSUER=SecureApp
# Accepted clock drift in 30-second steps (4 ≈ ±2 minutes). Lower = stricter.
TOTP_WINDOW=4
